{
  "extends": "../../tsconfig.base.json",
  // rootDir spans the backend root so shared/ compiles alongside src/.
  // Output lands at dist/services/<svc>/src/ and dist/shared/ — hence the
  // longer path in the Dockerfile's CMD.
  "compilerOptions": { "outDir": "./dist", "rootDir": "../.." },
  "include": ["src/**/*", "../../shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
