{
  "extends": "../../tsconfig.base.json",
  // No shared/ here: this service imports nothing from it, and pulling
  // shared/auth.ts into the compile would require jsonwebtoken deps it does
  // not have. Add both together if that changes.
  "compilerOptions": { "outDir": "./dist", "rootDir": "./src" },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
